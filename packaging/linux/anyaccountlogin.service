[Unit]
Description=AnyAccountLogin Daemon
After=network.target
Before=multi-user.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/anyaccountlogin-daemon
Restart=on-failure
RestartSec=5s

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/anyaccountlogin

[Install]
WantedBy=multi-user.target
