<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anyaccountlogin.daemon</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/anyaccountlogin-daemon</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <true/>
    
    <key>StandardOutPath</key>
    <string>/var/log/anyaccountlogin/daemon.log</string>
    
    <key>StandardErrorPath</key>
    <string>/var/log/anyaccountlogin/daemon.error.log</string>
    
    <key>WorkingDirectory</key>
    <string>/var/lib/anyaccountlogin</string>
    
    <key>ProcessType</key>
    <string>Interactive</string>
    
    <key>Nice</key>
    <integer>0</integer>
    
    <key>UserName</key>
    <string>root</string>
    
    <key>GroupName</key>
    <string>wheel</string>
</dict>
</plist>
